        "z": "cd3566b28c08eb81",
        "name": "Procesar datos",
        "func": "\nlet datos = msg.payload;\n\n// Convertir el mensaje a un objeto\nif (typeof datos === \"string\") {\n    datos = JSON.parse(datos);\n}\n\n// Preparar la información\nmsg.payload = {\n    temperatura: datos.temperatura,\n    estadoLED: datos.led === 1 ? \"Encendido\" : \"Apagado\"\n};\n\n// Enviar el resultado al siguiente bloque\nreturn msg;\n",
